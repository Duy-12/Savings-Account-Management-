# ====================================================================
# CẤU HÌNH MÔI TRƯỜNG BACKEND - HỆ THỐNG QUẢN LÝ SỔ TIẾT KIỆM
# Hướng dẫn: Sao chép file này thành `.env` trong thư mục `backend/`
# (Windows CMD/PS: copy .env.example .env) và điền thông số máy bạn.
# KHÔNG commit file `.env` thật lên Git!
# ====================================================================

# 1. Server & Environment
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5500

# 2. MySQL Database Connection (Khớp backend/database/schema.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=quan_ly_so_tiet_kiem
DB_CONNECTION_LIMIT=10

# 3. Authentication & Security (FR-01, EX-01)
# Production: Đổi JWT_SECRET thành chuỗi ngẫu nhiên tối thiểu 64 ký tự!
JWT_SECRET=dev_coresavings_super_secret_change_me_in_production_2026
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15

# 4. Notification Gateway (FR-13, EX-02)
# Giá trị: 'mock' (ghi log console + bảng THONG_BAO) hoặc 'smtp' (gửi email thật)
NOTIFY_MODE=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CoreSavings Bank <no-reply@savingsbank.vn>"

# 5. Scheduler / Cron Jobs (FR-13 Quét nhắc đáo hạn & FR-14 Tái tục tự động)
ENABLE_CRON_JOBS=true
# 08:00 sáng hằng ngày quét sổ sắp đáo hạn 1-3 ngày
CRON_MATURITY_SCHEDULE=0 8 * * *
# 23:55 cuối ngày chạy tái tục sổ tự động
CRON_ROLLOVER_SCHEDULE=55 23 * * *
